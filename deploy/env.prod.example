# ============================================================
# TripOps - biến môi trường production
# Trên VPS:  cp deploy/env.prod.example deploy/.env  && nano deploy/.env
# KHÔNG commit deploy/.env (đã nằm trong .gitignore: **/.env)
# ============================================================

# --- Tên miền & HTTPS ---
DOMAIN=tripops.online
ACME_EMAIL=lienhe@tripops.online

# --- SQL Server ---
# Ít nhất 8 ký tự, có hoa + thường + số + ký tự đặc biệt.
# KHÔNG dùng ; ' " $ ` trong mật khẩu (vỡ connection string / shell).
MSSQL_SA_PASSWORD=DoiMatKhau_Manh123!
MSSQL_MEMORY_LIMIT_MB=3072
DB_NAME=TripOps

# --- Lưu file: Cloudinary (ảnh) ---
Storage__UseLocal=false
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# --- payOS (thu tiền) ---
PayOs__BaseUrl=https://api-merchant.payos.vn
PayOs__ClientId=
PayOs__ApiKey=
PayOs__ChecksumKey=
PayOs__ReturnUrl=https://tripops.online/api/v1/payments/payos/return
PayOs__FrontendBaseUrl=https://tripops.online/
PayOs__LinkMinutes=15

# --- payOS Payout (chi tiền cho agency/provider) ---
PayOsPayout__BaseUrl=https://api-merchant.payos.vn
PayOsPayout__ClientId=
PayOsPayout__ApiKey=
PayOsPayout__ChecksumKey=

# --- Quyết toán ---
# CẢNH BÁO: true = hệ thống TỰ CHUYỂN TIỀN THẬT qua payOS Payout. Để false cho tới khi chắc chắn.
Settlement__AutoPayoutEnabled=false
Settlement__AutoPayoutDelayDays=0
Settlement__BankAccountCooldownHours=0

# --- AI (DeepSeek, API tương thích OpenAI) ---
OpenAI__BaseUrl=https://api.deepseek.com
OpenAI__ApiKey=
OpenAI__Model=deepseek-flash
OpenAI__Thinking=disabled

# --- Push FCM (không bắt buộc) ---
# Firebase__ProjectId=
