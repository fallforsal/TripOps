# Leave empty to use /api on the current origin (Vite proxies to localhost:5080).
# In production proxy /api to the backend on the same site.
VITE_API_BASE_URL=
# Address encoded in the contract-signing QR code. Leave empty to use the current page address
# (open the site via the LAN IP, e.g. npm run dev -- --host, so a phone can reach it). Set to the real domain when deployed.
VITE_PUBLIC_APP_URL=
